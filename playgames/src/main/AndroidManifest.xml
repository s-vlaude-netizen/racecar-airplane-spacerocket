<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The id of the Play Games Services project (res/values/play_games_ids.xml); the Play Games SDK reads it when it is started. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/pg_app_id" />

        <!--
            The SDK would start itself through this provider when the process starts, on every device, whether Google Play services are there
            or not, and whether the game is set up or not. The game starts it by hand (PlayGamesLeaderboards) when it knows that it can work.
        -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            tools:node="remove" />
    </application>
</manifest>
